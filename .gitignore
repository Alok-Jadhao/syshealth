# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime artefacts
*.db
*.db-wal
