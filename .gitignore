# Local config and recorded runs. Note this is deliberately specific:
# the old .gitignore had a blanket `*.json`, which silently excluded the
# instance catalog and any committed fixture.
syshealth.toml
runs/
!tests/fixtures/**

# Chaos environment runtime state
chaos/.state/
