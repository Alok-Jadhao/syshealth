__pycache__
*.log
node_modules/
.venv/
venv/

# Written by `syshealth.py calibrate`, and specific to the machine that ran it.
# Narrow rather than *.json, which would also swallow package.json.
baseline.json
# terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
# Workspaces: aws.sh's fleet and rightsize.sh's (state holds the fleet's token).
terraform/terraform.tfstate.d/
# What aws.sh up built with, and the fleet's SSH host keys.
terraform/.aws-fleet
terraform/.aws-fleet-known_hosts
terraform/*.tfvars
terraform/*.tfvars.bak
terraform/.relaunch.plan
terraform/.terraform.lock.hcl

# Reports saved by cli.py --save and terraform/rightsize.sh.
rightsize-*.json

# Written by the agent (reporter.py) in whatever directory it runs from.
status.json
